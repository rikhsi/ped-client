{
  "name": "pedagog",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-prod": "ng serve --configuration production",
    "start-test-prod": "ng serve --configuration test-prod",
    "build-prod": "ng build --configuration production",
    "build-testing": "ng build --configuration testing",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:outline": "svg-to-ts-object --config ./configs/svg-outline.json",
    "generate:fill": "svg-to-ts-object --config ./configs/svg-fill.json",
    "generate:two-tone": "svg-to-ts-object --config ./configs/svg-two-tone.json",
    "generate:colorful": "svg-to-ts-object --config ./configs/svg-colorful.json",
    "postinstall": "npm run generate:outline && npm run generate:fill && npm run generate:two-tone && npm run generate:colorful"
  },
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/common": "^21.1.1",
    "@angular/compiler": "^21.1.1",
    "@angular/core": "^21.1.1",
    "@angular/forms": "^21.1.1",
    "@angular/platform-browser": "^21.1.1",
    "@angular/platform-browser-dynamic": "^21.1.1",
    "@angular/platform-server": "^21.1.1",
    "@angular/router": "^21.1.1",
    "@angular/ssr": "^21.1.1",
    "@auth0/angular-jwt": "^5.2.0",
    "@jsverse/transloco": "^8.2.1",
    "angular8-yandex-maps": "^21.0.0",
    "date-fns": "^4.1.0",
    "ng-apexcharts": "^2.0.4",
    "ng-zorro-antd": "^21.0.2",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-mask": "^20.0.3",
    "postinstall": "^0.11.2",
    "rxjs": "~7.8.2",
    "swiper": "^12.1.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.5.1",
    "svg-to-ts": "^12.0.0",
    "typescript": "~5.9.3"
  }
}
